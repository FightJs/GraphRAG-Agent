# ── 必须配置 ───────────────────────────────────────────────
SECRET_KEY=your-super-secret-jwt-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 数据库 ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./graphrag.db

# ── 存储路径 ───────────────────────────────────────────────
UPLOAD_DIR=./storage/uploads
KG_DIR=./storage/kg
CHUNKS_DIR=./storage/chunks
MEDIA_DIR=./storage/media

# ── 表格结构化（SPEC-TABLE）────────────────────────────────
TABLE_SUMMARY_ENABLED=true
TABLE_SUMMARY_MAX_TOKENS=512
TABLE_SUMMARY_MIN_CELLS=4
TABLE_LLM_REPAIR_ENABLED=true
TABLE_MAX_ROWS_FOR_FULL_PROMPT=80

# ── 图片智能解析（SPEC-IMAGE）──────────────────────────────
VLM_MODEL=qwen/qwen2.5-vl-72b-instruct
VLM_MAX_IMAGE_SIDE=1568
VLM_MAX_IMAGES_PER_DOC=40
VLM_CONCURRENCY=4
MEDIA_ROUTE_MIN_CONFIDENCE=0.55
IMAGE_DESC_MAX_TOKENS=512
OCR_ENGINE=rapidocr
OCR_LANG=ch
MIN_OCR_CHARS=10
OCR_MIN_AVG_CONFIDENCE=0.5
IMAGE_MIN_SIDE_PX=32
IMAGE_MIN_AREA_PX=1024
VLM_CONCURRENCY=4
IMAGE_MIN_AREA_PX=1024

# ── 部署安全密钥（必须由密钥管理服务注入，不要提交到 Git）────
# 生成示例：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=

# ── 服务端 Provider 端点（用户凭据在设置页验证后加密存入数据库）─
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MINERU_BASE_URL=https://mineru.net/api/v4
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# ── MinerU 解析（用户在设置页配置 MinerU Key 后，PDF 走结构化解析）──
MINERU_LANGUAGE=ch
MINERU_ENABLE_OCR=true
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=false
MINERU_POLL_INTERVAL=3
MINERU_POLL_TIMEOUT=300
# 分块粒度：page | section | full
MINERU_SPLIT_BY=page
MINERU_CHUNK_MAX_CHARS=1200
MINERU_CHUNK_OVERLAP=150

# ── 跨域前端地址（逗号分隔）─────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── 服务端口 ───────────────────────────────────────────────
PORT=8000
