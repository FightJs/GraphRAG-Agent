# ── 必须配置 ───────────────────────────────────────────────
SECRET_KEY=your-super-secret-jwt-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 数据库 ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./graphrag.db

# ── 存储路径 ───────────────────────────────────────────────
UPLOAD_DIR=./storage/uploads
KG_DIR=./storage/kg

# ── 外部 API（可留空，系统将使用 Mock 模式）──────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MINERU_API_KEY=

# ── 服务端口 ───────────────────────────────────────────────
PORT=8000
